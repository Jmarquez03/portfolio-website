# Hostinger (Apache): serve index.html for client-side routes like /work/apple
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  # JS and CSS are content-hashed by Vite, so they can be cached for a year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # photos, icons and resumes keep their names when replaced: cache for a day
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|pdf|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # always fetch the latest page
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
